# 發行打包用映像（Linux、Windows）：在共用基底 dosgolem-rust-sc 之上加 mingw-w64 與 squashfs（AppImage）。
# macOS 用 tools/Dockerfile.macos。建置：tools/package.sh image（需要網路）。
FROM dosgolem-rust-sc:1.99.1-r1
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends mingw-w64 squashfs-tools file zip \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-pc-windows-gnu
USER 1000:1000
